# Variables lues par docker compose. Copier en `.env` et adapter.
#   cp .env.example .env

# ── Base de donnees ───────────────────────────────────────────────────────────
POSTGRES_USER=ddos
POSTGRES_PASSWORD=ddos
POSTGRES_DB=ddos_monitor

# ── Ports publies ─────────────────────────────────────────────────────────────
# FRONTEND_PORT sert l'interface ET relaie /api et /ws : nginx est embarque dans
# l'image du frontend, ce n'est pas un service a part dans docker-compose.
FRONTEND_PORT=8080
BACKEND_PORT=8000
PGADMIN_PORT=5050

# ── pgAdmin (consultation de la base sur http://localhost:5050) ───────────────
# L'adresse doit avoir un domaine valide : pgAdmin refuse les TLD comme .local.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin123

# ── Securite (obligatoire en production) ──────────────────────────────────────
# openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-a-long-random-value
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=http://localhost:8080

# Compte administrateur cree au premier demarrage
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@ddos-monitor.local
FIRST_ADMIN_PASSWORD=admin123

# ── Capture : d'ou viennent les donnees ? ─────────────────────────────────────
# simulator (defaut) : trafic SYNTHETIQUE genere par le backend.
#                      Les IP affichees sont fabriquees, ce n'est pas votre reseau.
# external           : aucune capture interne ; les donnees arrivent de
#                      tools/capture_agent.py, qui capture le trafic REEL de
#                      votre machine et le poste sur /api/ingest.
#                      -> seule option qui fonctionne sur macOS.
# tshark             : capture depuis le backend lui-meme (Linux uniquement,
#                      avec docker-compose.capture.yml).
CAPTURE_BACKEND=simulator
CAPTURE_INTERFACE=eth0
CAPTURE_ENABLED=true
ANALYSIS_INTERVAL_SECONDS=15
ATTACK_CONFIDENCE_THRESHOLD=0.70
ATTACK_FLOW_THRESHOLD=3

# ── Pare-feu : le blocage d'IP agit-il vraiment ? ─────────────────────────────
# false (defaut) : la liste des IP bloquees est un inventaire, AUCUNE regle
#                  n'est posee et le trafic continue de passer.
# true           : les regles sont reellement appliquees. Choisir le backend
#                  correspondant a l'hote et fournir les privileges necessaires
#                  (NET_ADMIN sous Linux, root pour pfctl sous macOS).
# Un backend « none » n'applique aucune regle : la liste reste un simple
# inventaire. Pour un blocage reel, choisissez iptables et laissez le cap_add
# NET_ADMIN present dans docker-compose.yml.
FIREWALL_ENABLED=false
FIREWALL_BACKEND=none          # none | iptables (Linux) | pfctl (macOS)

# ── Alertes email via Gmail ───────────────────────────────────────────────────
# SMTP_PASSWORD doit etre un MOT DE PASSE D'APPLICATION Google (16 caracteres) :
#   1. activer la verification en deux etapes sur le compte Google ;
#   2. le generer sur https://myaccount.google.com/apppasswords ;
#   3. le coller ci-dessous, dans .env (jamais dans .env.example ni dans git).
# Le mot de passe habituel du compte est refuse par Google depuis 2022.
ALERT_EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=votre_adresse_google
SMTP_PASSWORD=
# Destinataires des alertes, separes par des virgules
ALERT_RECIPIENTS=adresse_mail_destination
