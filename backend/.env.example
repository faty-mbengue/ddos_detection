# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Base de donnees ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://ddos:ddos@localhost:5432/ddos_monitor

# ── Securite ──────────────────────────────────────────────────────────────────
# Generer une valeur avec : openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Compte administrateur cree au premier demarrage
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@ddos-monitor.local
FIRST_ADMIN_PASSWORD=admin123

# ── Capture du trafic : d'ou viennent les donnees ? ───────────────────────────
# simulator : trafic SYNTHETIQUE genere par le backend (defaut). Les adresses IP
#             affichees sont fabriquees : ce n'est pas le trafic de votre reseau.
# external  : aucune capture interne. tools/capture_agent.py capture le trafic
#             REEL de la machine hote et le poste sur POST /api/ingest.
#             Seule option viable sur macOS (Docker y tourne dans une VM Linux,
#             donc un conteneur ne voit jamais les interfaces du Mac).
# tshark    : capture depuis le backend (Linux : NET_ADMIN + network_mode host).
CAPTURE_BACKEND=simulator
CAPTURE_INTERFACE=eth0
CAPTURE_ENABLED=true
ANALYSIS_INTERVAL_SECONDS=15

# ── Pare-feu : le blocage d'IP est-il applique ? ──────────────────────────────
# false : la table blocked_ips reste un inventaire, aucune regle n'est posee.
# true  : les regles sont reellement appliquees (privileges requis).
FIREWALL_ENABLED=false
FIREWALL_BACKEND=none

# ── Detection ─────────────────────────────────────────────────────────────────
ATTACK_CONFIDENCE_THRESHOLD=0.70
ATTACK_FLOW_THRESHOLD=3

# ── Alertes email (optionnel) ─────────────────────────────────────────────────
ALERT_EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@ddos-monitor.local
ALERT_RECIPIENTS=
